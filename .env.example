# =========================================================
# FRONTEND CONFIGURATION (.env)
# =========================================================
# In local development:
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/hq
VITE_ENABLE_MOCK_FALLBACK=true

# In production (e.g. Vercel dashboard):
# VITE_API_BASE_URL=https://your-backend-name.onrender.com
# VITE_WS_URL=wss://your-backend-name.onrender.com/ws/hq
# VITE_ENABLE_MOCK_FALLBACK=false

# =========================================================
# BACKEND CONFIGURATION (Environment variables in Render / Railway)
# =========================================================
# DATABASE_URL=sqlite:///./resqsync.db
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
